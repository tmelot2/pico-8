pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
-- (0,0) - (15,15)
-- therefore, len=16,16
--
-- grid 5x5 11x11
-- bord 2x2  9x9
-- 

screenwidth = 128
screenheight = 128

bw=5 bh=5
board={}
button=0
t=0

-- board
function new_board(x,y,w,h)
	local b={
		x=x, y=y, -- draw coords
		w=w, h=h  -- game board dimensions in tiles
	}
	b.pad=3
	b.width_px=8*w
	b.height_px=8*h

	return b
end

function draw_board(b)
	tw=8 th=8
	for i=0, b.w-1 do
		for j=0, b.h-1 do
			-- spr((j+i)%4+1, b.x+tw*i, b.y+th*j)
			spr((j+i)%4+1, b.x+tw*i, b.y+th*j+25*sin(2*(t+i+j)/120))
		end
	end
	-- rect(b.x, b.y, b.x+b.width_px-1, b.y+b.height_px-1, 7)
end

-- main
function _init()
	board = new_board(0,0,5,5)
end

function _update60()
	input()
	t+=1
end

function _draw()
	cls(0)
	-- print(button, 12, 12)
	-- drawborder()
	-- drawboard()
	draw_board(board)

	print(board.w..','..board.h,0,112,8)
end

function drawborder()
	tw=8 th=8
	spr(16,bx,by) -- top left
	spr(17,bx+tw*(bw+1),by) -- top right
	spr(32,bx,by+th*(bh+1)) -- bottom left
	spr(33,bx+tw*(bw+1),by+th*(bh+1)) -- bottom right

	for i=1,bw do
		spr(48,bx+tw*i,by) -- top
		spr(49,bx+tw*i,by+th*(bh+1)) -- bottom
	end
	for i=1,bh do
		spr(50,bx,by+th*i) -- left
		spr(51,bx+tw*(bw+1),by+th*i) -- right
	end
end


-- input
function input()
	if btnp(0) then -- l
		bw-=1
		board=new_board(0,0,bw,bh)
	end
	if btnp(1) then -- r
		bw+=1
		board=new_board(0,0,bw,bh)
	end
	if btnp(2) then -- u
		bh-=1
		board=new_board(0,0,bw,bh)
	end
	if btnp(3) then -- d
		bh+=1
		board=new_board(0,0,bw,bh)
	end
	if btn(4) then button='o' end -- o
	if btn(5) then button='x' end -- x
	if btn() == 0 then button='' end -- d
end

