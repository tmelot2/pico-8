pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
-- (0,0) - (15,15)
-- therefore, len=16,16
--
-- grid 5x5 11x11
-- bord 2x2  9x9
-- 

screenwidth = 128
screenheight = 128

-- board
bx=0 by=0
bw=5 bh=5 -- inner, ignoring border

button=0

-- main
function _init()
end

function _update60()
	input()
end

function _draw()
	cls(0)
	print(button, 12, 12)
	drawborder()
	drawboard()
	print(bw..','..bh,0,112,8)

end

function drawborder()
	tw=8 th=8
	spr(16,bx,by) -- top left
	spr(17,bx+tw*(bw+1),by) -- top right
	spr(32,bx,by+th*(bh+1)) -- bottom left
	spr(33,bx+tw*(bw+1),by+th*(bh+1)) -- bottom right

	for i=1,bw do
		spr(48,bx+tw*i,by) -- top
		spr(49,bx+tw*i,by+th*(bh+1)) -- bottom
	end
	for i=1,bh do
		spr(50,bx,by+th*i) -- left
		spr(51,bx+tw*(bw+1),by+th*i) -- right
	end
end

function drawboard()
	tw=8 th=8
	for i=1,bw do
		for j=1,bh do
			spr(1,bx+tw*i,by+th*j)
		end
	end
end


-- input
function input()
	if btnp(0) then bw-=1 end -- l
	if btnp(1) then bw+=1 end -- r
	if btnp(2) then bh-=1 end -- u
	if btnp(3) then bh+=1 end -- d
	if btn(4) then button='o' end -- o
	if btn(5) then button='x' end -- x
	if btn() == 0 then button='' end -- d
end

